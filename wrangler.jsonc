{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bharathunt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Production traffic is attached as *routes*, not Custom Domains — deliberately.
  //
  // A Custom Domain requires the Worker to own the DNS record, so Cloudflare refuses to
  // attach one on top of the existing Vercel-pointing records: "Hostname 'bharathunt.org'
  // already has externally managed DNS records" (API code 100117). Honouring that would
  // mean deleting the apex records first, which takes the site down for the window
  // between the delete and the attach.
  //
  // A route instead runs the Worker *in front of* the existing proxied record. The DNS
  // records stay exactly as they are, so the cutover has no downtime at all: Cloudflare
  // hands the request to this Worker and the Vercel origin behind it is simply never
  // consulted. Rollback is removing these two entries and redeploying — traffic falls
  // back through to Vercel with no DNS edit and no propagation wait.
  //
  // Safe here because nothing in the app fetch()es its own hostname (a Worker on a route
  // cannot call back into its own zone); SITE_URL only ever builds metadata, canonical
  // and sitemap strings.
  "routes": [
    { "pattern": "bharathunt.org/*", "zone_name": "bharathunt.org" },
    // www is served here too, so the www → apex 301 in next.config.ts runs on this
    // Worker instead of leaving a second live origin on Vercel.
    { "pattern": "www.bharathunt.org/*", "zone_name": "bharathunt.org" },
    // Staging origin on the same build, for exercising production keys without touching
    // the apex. This one stays a Custom Domain: Cloudflare created its DNS record itself,
    // so there was never a pre-existing record to conflict with.
    { "pattern": "cf.bharathunt.org", "custom_domain": true }
  ],

  // Smart Placement moves the Worker close to the origin it talks to most
  // (Supabase). The app makes ~3 Supabase round-trips per render, so pinning the
  // compute near the database matters more than being near the viewer — this is
  // the Workers equivalent of the old `vercel.json` "regions": ["bom1"] pin.
  "placement": {
    "mode": "smart"
  },
  // Incremental (ISR / full-route) cache. NOTE: the R2 bucket must be created
  // before `wrangler deploy` — R2 has to be enabled once in the Cloudflare
  // dashboard first. `opennextjs-cloudflare preview` simulates it locally, so
  // local runs work without the remote bucket existing.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "bharathunt-inc-cache"
    }
  ],
  // Tag cache backing revalidateTag/revalidatePath.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "bharathunt-tag-cache",
      "database_id": "0a381201-00e5-4b62-b435-608625d8734c"
    }
  ],
  // Durable Object queue that drains background ISR revalidations.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // The queue calls the Worker back to run revalidations.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bharathunt"
    }
  ]
}
