{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bharathunt-ingest-scheduler",
  "main": "index.js",
  "compatibility_date": "2026-09-05",

  // No `fetch` handler and no public URL. Cron is the only way in, so a
  // workers.dev hostname would be a public address that serves nothing —
  // and one more thing to have to reason about.
  "workers_dev": false,

  // Disabled. Ingestion runs once a day from .github/workflows/ingest.yml, in
  // batches, plus "Run now" on the admin dashboard. This ran every ten minutes
  // until 2026-09-18, alongside that workflow — two schedulers for one job.
  // An empty list is what makes `wrangler deploy` remove the live trigger;
  // deleting the key would leave it in place. Add a cron back only after
  // removing the workflow's `schedule`, or both will run.
  "triggers": {
    "crons": []
  },

  // Direct binding to the app Worker: no DNS, no TLS, no trip out to the
  // internet and back, and it does not consume an external subrequest.
  "services": [
    {
      "binding": "APP",
      "service": "bharathunt"
    }
  ],

  "observability": {
    "enabled": true
  }
}
