# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is the
# committed template, so it must never contain a real secret.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # server-only; used by the Clerk webhook

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>
CLERK_WEBHOOK_SIGNING_SECRET=<your-clerk-webhook-signing-secret>

# Email — Sendgrove Unified API v2 for advertising inquiry mail (lib/email.ts)
SENDGROVE_API_KEY=<keyId>:<keySecret>                   # sent as the X-API-Key header
EMAIL_FROM=Bharat Hunt <ads@bharathunt.org>             # must be a VERIFIED sender
EMAIL_FALLBACK_FROM=Bharat Hunt <info@bharathunt.org>   # optional; see README

# Launch review — signs the one-click Approve / Send back links in the review
# email so they work without a login. Any long random string; rotate it and
# every outstanding link stops working. Without it the mail still arrives, but
# links to the admin queue instead (sign-in required).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_REVIEW_SECRET=<a-long-random-string>

# Dodo Payments — payments for /promote/checkout (REQUIRED to sell promotion slots)
#
# Both secrets are SERVER-ONLY. Neither is prefixed NEXT_PUBLIC_, and neither may
# be: a NEXT_PUBLIC_ variable is inlined into the JavaScript every visitor
# downloads. Unlike Razorpay, Dodo issues no publishable key at all — every API
# key is secret — so there is nothing here that is safe to expose and nothing
# that needs to be. The browser is sent to a Dodo-hosted checkout URL instead.
#
# Dodo Dashboard > Developer > API Keys. The key's prefix must match the
# environment below (dodo_live_* with live_mode, dodo_test_* with test_mode);
# a mismatch is refused up front rather than failing as a 401 that reads like an
# outage.
DODO_PAYMENTS_API_KEY=dodo_test_xxxxxxxxxxxxxxxx
# Dodo Dashboard > Developer > Webhooks > (your webhook) > Signing secret.
# A DIFFERENT value from the API key above. Swapping the two fails every webhook
# signature check silently, so paid promotions would never activate.
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxxxxxxxxxxxxxxx
# live_mode or test_mode. ANY other value (including unset) selects test_mode —
# a misconfigured deployment must fail closed and take no money, so production
# has to say live_mode explicitly.
DODO_PAYMENTS_ENVIRONMENT=test_mode
#
# One more step that is NOT an environment variable: each row of
# `promotion_packages` needs its `dodo_product_id` set to the matching Dodo
# product (Dashboard > Products), priced identically to `amount_paise`. Until
# then the checkout hides that package rather than offering one it cannot
# charge for.

# Cloudflare Turnstile — captcha on the /advertise inquiry form (REQUIRED for that form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

# Cloudinary — image uploads on /submit (REQUIRED to upload; URL paste still works without it)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your-UNSIGNED-upload-preset>

# Google Analytics 4 — measurement ID for the web data stream
# (GA4 Admin > Data streams > your web stream > Measurement ID, format G-XXXXXXXXXX).
# Not a secret; it ships in the page source of every GA site.
# Omit the line to use the project default in lib/constants.ts.
# Set it to an EMPTY value to switch GA4 off entirely.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Set true to let Tag Assistant / GA4 DebugView see a local `npm run dev` page.
# Leave unset otherwise, or local browsing is counted as real traffic.
# NEXT_PUBLIC_GA_DEBUG=true

# Official social profiles — full URLs of accounts you actually control.
# Each one set here renders in the footer AND joins schema.org `sameAs`, which is
# how a search engine decides which accounts are this organisation. Leave a
# platform unset and it simply does not appear; never point one at an account
# you do not own.
# NEXT_PUBLIC_SOCIAL_X=https://x.com/<handle>
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/<slug>
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/<handle>
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@<handle>

# Optional overrides
# Canonical origin for metadata, canonicals, the sitemap and OG images. Defaults
# to https://bharathunt.org in lib/constants.ts, so set this only for a
# deployment that should describe itself as something else (a preview, staging).
# NEXT_PUBLIC_SITE_URL=https://staging.bharathunt.org
# NEXT_PUBLIC_ADMIN_EMAILS=you@example.com,other@example.com
